<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.Laymer000007.PdrSign</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <name>PDR Sign</name>
  <summary>Portable Document Read and Sign</summary>
  <developer id="io.github.laymer000007">
    <name>Laymer000007</name>
  </developer>
  <description>
    <p>
      PDR is a calm, fast PDF reader for the Linux desktop. Documents open in a
      continuous, smoothly scrolling view with thumbnails, the outline, full-text
      search, text selection and printing, and it follows your light or dark theme.
    </p>
    <p>
      Fill &amp; Sign lets you complete forms without leaving the reader: type into
      form fields, add text, ticks, crosses, dots, lines and dates anywhere on the page,
      and place your signature, initials or a company stamp. Draw a signature with a
      touchpad or mouse, type it in a handwriting font, or clean up a phone photo of it
      on paper. Saved signatures and stamps stay on your computer.
    </p>
    <p>
      Save keeps your entries editable in PDR and visible in every PDF reader. Save
      signed copy writes a new file next to the original with everything locked into
      the pages, while the original stays unchanged for corrections.
    </p>
  </description>
  <launchable type="desktop-id">io.github.Laymer000007.PdrSign.desktop</launchable>
  <provides>
    <binary>pdr-sign</binary>
    <mediatype>application/pdf</mediatype>
  </provides>
